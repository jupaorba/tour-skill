{
  "name": "@waypoint-tours/react",
  "version": "0.1.0",
  "description": "Add guided product tours to your React app: a provider plus a one-line useTour() hook. Powered by the Waypoint runtime.",
  "license": "MIT",
  "author": "Juan Pablo Ortiz Ballna",
  "repository": {
    "type": "git",
    "url": "https://github.com/jupaorba/tour-skill.git",
    "directory": "packages/react"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@waypoint-tours/runtime": "0.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "react": "^18.3.1",
    "tsup": "^8.1.0",
    "typescript": "^5.5.3"
  }
}
