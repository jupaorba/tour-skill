{
  "name": "@waypoint-tours/vue",
  "version": "0.1.0",
  "description": "Add guided product tours to your Vue 3 app: a plugin plus a one-line useTour() composable. Powered by the Waypoint runtime.",
  "license": "MIT",
  "author": "Juan Pablo Ortiz Ballna",
  "repository": {
    "type": "git",
    "url": "https://github.com/jupaorba/tour-skill.git",
    "directory": "packages/vue"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "dependencies": {
    "@waypoint-tours/runtime": "0.1.0"
  },
  "devDependencies": {
    "tsup": "^8.1.0",
    "typescript": "^5.5.3",
    "vue": "^3.4.31",
    "vue-tsc": "^2.0.24"
  }
}
